generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FulfillmentMethod {
  SELF_PICKUP
  DELIVERY
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String?
  googleId             String?
  image                String    @default("...")
  address              Json      @default("{}")
  gender               String    @default("Not Selected")
  dob                  String    @default("Not Selected")
  phone                String    @default("0000000000")
  isActive             Boolean   @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@unique([phone])
  @@map("users")
}

model Branch {
  id           String      @id @default(uuid())
  name         String
  machineCount Int         @default(10)
  email        String      @unique
  password     String
  phone        String
  image        String
  speciality   String[]
  about        String
  fees         Int         @default(0)
  address      Json
  available    Boolean     @default(true)
  slotsBooked  Json        @default("{}")
  date         BigInt      @default(0)
  isActive     Boolean     @default(true)
  inventories  Inventory[]

  @@map("branches")
}

model Admin {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String
  isActive             Boolean   @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("admins")
}

enum BookingSource {
  ONLINE
  WALK_IN
}

model Appointment {
  id                     String                    @id @default(uuid())
  userId                 String?
  bookingSource          BookingSource             @default(ONLINE)
  guestName              String?
  guestContact           String?
  branchId               String
  branchData             Json
  userData               Json
  servicesTotal          Float
  addOnsTotal            Float                     @default(0)
  totalAmount            Float
  vatRate                Float                     @default(0)
  vatAmount              Float                     @default(0)
  promoCodeId            String?
  promoCode              String?
  discountType           String?
  discountValue          Float                     @default(0)
  discountAmount         Float                     @default(0)
  finalAmount            Float
  weightConfirmedAt      DateTime?
  weightConfirmedBy      String?
  preferredPaymentMethod String                    @default("cash")
  paymentStatus          String                    @default("unpaid")
  paymentMethod          String?
  paymentPaidAt          DateTime?
  payment                Boolean                   @default(false)
  slotDate               String
  slotTime               String
  date                   BigInt
  pickupAddress          Json?
  deliveryAddress        Json?
  fulfillmentMethod      FulfillmentMethod         @default(DELIVERY)
  deliveryStatus         String                    @default("pending_approval")
  cancelled              Boolean                   @default(false)
  isCompleted            Boolean                   @default(false)
  specialInstructions    String?
  sessionId              String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  refundAmount           Float?
  refundNote             String?
  refundReason           String?
  refundRejectedAt       DateTime?
  refundRejectedBy       String?
  refundRejectionNote    String?
  refundStatus           String                    @default("none")
  refundedAt             DateTime?
  overweightDeadline     DateTime?
  overweightExcessKg     Float?
  overweightNotifiedAt   DateTime?
  overweightResolution   String?
  overweightResolvedAt   DateTime?
  overweightStatus       String                    @default("none")
  addOns                 AppointmentAddOn[]
  clothingTypes          AppointmentClothingType[]
  services               AppointmentService[]
  archived               Boolean                   @default(false)
  archivedAt             DateTime?
  archivedBy             String?

  @@map("appointments")
}

model AppointmentService {
  id            String      @id @default(uuid())
  appointmentId String
  serviceId     String
  name          String?
  price         Float?
  kg            Float
  actualKg      Float?
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@map("appointment_services")
}

model AppointmentAddOn {
  id            String      @id @default(uuid())
  appointmentId String
  productId     String
  name          String
  price         Float
  quantity      Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@map("appointment_addons")
}

model AppointmentClothingType {
  id             String      @id @default(uuid())
  appointmentId  String
  clothingTypeId String
  appointment    Appointment @relation(fields: [appointmentId], references: [id])

  @@map("appointment_clothing_types")
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  actor     Json
  target    Json?
  branchId  String?
  before    Json?
  after     Json?
  meta      Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ClothingType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  price     Float    @default(0)

  @@map("clothing_types")
}

model ExtraService {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  fee         Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("extra_services")
}

model KgRate {
  id        String   @id @default(uuid())
  kg        Float
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kg_rates")
}

model Product {
  id                String                  @id @default(uuid())
  name              String
  description       String                  @default("")
  price             Float
  category          String                  @default("other")
  image             String                  @default("")
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  inventories       Inventory[]
  bundledInServices ServiceBundledProduct[]

  @@map("products")
}

model Inventory {
  id                String   @id @default(uuid())
  branchId          String
  productId         String
  quantity          Float    @default(0)
  lowStockThreshold Float    @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  branch            Branch   @relation(fields: [branchId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@map("inventories")
}

model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String    @default("")
  discountType   String
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("promo_codes")
}

model Service {
  id              String                  @id @default(uuid())
  name            String                  @unique
  price           Float
  image           String?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  description     String                  @default("")
  bundledProducts ServiceBundledProduct[]

  @@map("services")
}

model ServiceBundledProduct {
  id        String  @id @default(uuid())
  serviceId String
  productId String
  service   Service @relation(fields: [serviceId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([serviceId, productId])
  @@map("service_bundled_products")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

enum AuditAction {
  APPOINTMENT_CREATED
  APPOINTMENT_EDITED
  APPOINTMENT_STATUS_CHANGED
  APPOINTMENT_WEIGHT_CONFIRMED
  APPOINTMENT_PAYMENT_UPDATED
  APPOINTMENT_CANCELLED
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  SETTING_CHANGED
  INVENTORY_UPDATED
  INVENTORY_CREATED
  INVENTORY_DELETED
  BRANCH_CREATED
  BRANCH_UPDATED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
}