generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String?
  googleId             String?
  image                String    @default("...")
  address              Json      @default("{}")
  gender               String    @default("Not Selected")
  dob                  String    @default("Not Selected")
  phone                String    @default("0000000000")
  isActive             Boolean   @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("users")
}

// Hiwalay na login entity mula sa Admin/User, pero same JWT mechanism
// (protect(role) middleware, role nasa loob ng token — walang role column dito).
model Branch {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  phone       String
  image       String
  speciality  String[]
  about       String
  fees        Int      @default(0)
  address     Json
  available   Boolean  @default(true)
  isActive    Boolean  @default(true)  
  slotsBooked Json     @default("{}")
  date        BigInt   @default(0)

  inventories Inventory[]

  @@map("branches")
}

// Kapalit ng dating env-based ADMIN_EMAIL/ADMIN_PASSWORD (iisa, hardcoded).
// Same JWT mechanism gaya ng Branch/User — role nasa token, walang role column dito.
model Admin {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String
  isActive             Boolean   @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Appointment {
  id         String @id @default(uuid())
  userId     String
  branchId   String
  branchData Json
  userData   Json

  // servicesTotal = sum ng AppointmentService.price (fixed package prices) sa booking time.
  // OPEN QUESTION: potentially redundant vs. AppointmentService.price bilang source of truth —
  // hindi pa explicit na na-confirm kung tatanggalin, kaya PINANATILI muna.
  servicesTotal Float
  addOnsTotal   Float @default(0)
  totalAmount   Float

  vatRate   Float @default(0)
  vatAmount Float @default(0)

  promoCodeId    String?
  promoCode      String?
  discountType   String?
  discountValue  Float   @default(0)
  discountAmount Float   @default(0)

  // finalAmount = SNAPSHOT ng presyo noong booking. Hindi na ito nagbabago kahit
  // pagkatapos ng weight confirmation — walang automatic overweight fee formula.
  finalAmount Float

  // Checkpoint lang bago mag-request ng bayad — HINDI presyo trigger.
  // (actualKgPriceTotal, actualTotalAmount, actualVatAmount, actualFinalAmount,
  // overweightChargeTotal — TINANGGAL: hindi na nagbabago ang presyo pagkatapos i-timbang)
  weightConfirmedAt DateTime?
  weightConfirmedBy String?

  preferredPaymentMethod String    @default("cash")
  paymentStatus          String    @default("unpaid")
  paymentMethod          String?
  paymentPaidAt          DateTime?
  payment                Boolean   @default(false)

  // Refund tracking. refundStatus: "none" (default), "requested", "approved", "rejected", "completed".
  refundStatus        String    @default("none")
  refundAmount        Float?
  refundReason        String?
  refundNote          String?
  refundedAt           DateTime?
  refundRejectedAt     DateTime?
  refundRejectedBy     String?
  refundRejectionNote  String?

  slotDate String
  slotTime String
  date     BigInt

  pickupAddress   Json?
  deliveryAddress Json?

  deliveryStatus String  @default("pending_approval")
  cancelled      Boolean @default(false)
  isCompleted    Boolean @default(false)

  specialInstructions String?
  sessionId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services      AppointmentService[]
  addOns        AppointmentAddOn[]
  clothingTypes AppointmentClothingType[]

  @@map("appointments")
}

// Isang row = isang LOAD (isang basket/machine, isang resibo).
model AppointmentService {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  serviceId     String
  name          String?

  // price = SNAPSHOT ng fixed package price (Service.price) noong booking.
  // HINDI kinukwenta mula sa kg.
  price Float?

  // kg/actualKg = 7kg CAPACITY CHECK LANG, hindi presyo driver.
  // Kung sumobra: bawasan ng customer O gawing 2 hiwalay na load (2 buong-presyo entries).
  // (kgPrice, actualKgPrice, overweightCharge — TINANGGAL: walang automatic
  // "overweight fee" formula)
  kg       Float
  actualKg Float?

  @@map("appointment_services")
}

model AppointmentAddOn {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  productId     String
  name          String
  price         Float
  quantity      Int

  @@map("appointment_addons")
}

model AppointmentClothingType {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  clothingTypeId String

  @@map("appointment_clothing_types")
}

enum AuditAction {
  APPOINTMENT_CREATED
  APPOINTMENT_STATUS_CHANGED
  APPOINTMENT_WEIGHT_CONFIRMED
  APPOINTMENT_PAYMENT_UPDATED
  APPOINTMENT_CANCELLED
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  SETTING_CHANGED
  INVENTORY_UPDATED
  INVENTORY_CREATED
  INVENTORY_DELETED
  BRANCH_CREATED
  BRANCH_UPDATED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
}

model AuditLog {
  id     String      @id @default(uuid())
  action AuditAction

  actor  Json
  target Json?

  branchId String?

  before Json?
  after  Json?
  meta   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ClothingType {
  id        String   @id @default(uuid())
  name      String   @unique
  price     Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clothing_types")
}

model ExtraService {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  fee         Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("extra_services")
}

// DEPRECATED/UNUSED sa pricing logic (fixed per-load/package pricing na ang totoong flow,
// hindi per-kilo). PINANATILI ang table + CRUD dahil may aktibong Super Admin UI feature pa
// rin (KgRatesList.jsx). Cleanup backlog na lang, hindi priority.
model KgRate {
  id        String   @id @default(uuid())
  kg        Float
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kg_rates")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  price       Float
  category    String   @default("other")
  image       String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories Inventory[]

  @@map("products")
}

model Inventory {
  id                String   @id @default(uuid())
  branchId          String
  productId         String
  quantity          Float    @default(0)
  lowStockThreshold Float    @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@map("inventories")
}

model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String    @default("")
  discountType   String
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("promo_codes")
}

// Fixed per-load/package pricing. Menu: DIY Self-Service ₱140, Drop-off ₱180 (1 sabon 1 downy),
// Drop-off ₱250 (2 sabon 2 downy + booster), Full Service ₱235 (1 sabon 1 downy wash-dry-fold).
// OPEN QUESTION: 5th variant (Full Service 2 sabon 2 downy + booster) — wala pang kumpirmadong presyo.
model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  price       Float
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

// Well-known keys (generic upsert, primitives/JSON lang): vatRate (number 0-1),
// refundReasons (array — bawat item may { reason, applicableStatuses[], appliesToCancelled, isActive }),
// faqs (array).
model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
